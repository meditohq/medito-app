# Android keystore configuration for signing APKs
# Copy this file to keystore.properties and fill in your actual values

# Keystore password
storePassword=your_store_password_here

# Key password (usually same as store password)
keyPassword=your_key_password_here

# Key alias
keyAlias=your_key_alias_here

# Keystore file path (relative to android/ directory)
storeFile=your_keystore_file.jks

# Application package ID
appId=com.yourcompany.yourapp

# Version information (optional, used by build scripts)
versionCode=1
versionName=1.0.0
