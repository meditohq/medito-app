# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

# For a list of all available actions, check out
#     https://docs.fastlane.tools/actions

# For a list of all available plugins, check out
#     https://docs.fastlane.tools/plugins/available-plugins

# Disable auto-updating
# update_fastlane

default_platform(:android)

# Method to update .env with the appropriate values based on environment
def set_environment_values(url, init_token, sentry_dsn)
    Dir.chdir("..") do
      env_file_path = "../.prod.env"
      content = File.read(env_file_path)

    updated_content = "ENVIRONMENT=production\nENVIRONMENT_DEBUG=debug\n" + content
    updated_content = updated_content
                        .gsub(/^BASE_URL=.*/, "BASE_URL=#{url}")
                        .gsub(/^INIT_TOKEN=.*/, "INIT_TOKEN=#{init_token}")
                        .gsub(/^SENTRY_DSN=.*/, "SENTRY_DSN=#{sentry_dsn}")

    File.write(env_file_path, updated_content)
  end
end

# Read the +NNNNNN build-number suffix from pubspec.yaml.
def pubspec_version_code
  pubspec_path = File.expand_path('../pubspec.yaml', __dir__)
  content = File.read(pubspec_path)
  match = content.match(/^version:\s*\S+\+(\d+)/)
  UI.user_error!("Could not parse version code from #{pubspec_path}") unless match
  Integer(match[1])
end

# Query the production track via the Play Developer API and return every
# versionCode currently included in its releases. Used to verify a promote
# that Play's API rejected with a rollout-coverage error but may have
# committed anyway.
def production_track_version_codes(json_key_data, package_name)
  require 'google/apis/androidpublisher_v3'
  require 'googleauth'
  require 'stringio'

  creds = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: StringIO.new(json_key_data),
    scope: 'https://www.googleapis.com/auth/androidpublisher',
  )
  service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
  service.authorization = creds

  edit = service.insert_edit(package_name)
  begin
    track = service.get_edit_track(package_name, edit.id, 'production')
    (track.releases || []).flat_map { |r| r.version_codes || [] }.map(&:to_i).uniq
  ensure
    begin
      service.delete_edit(package_name, edit.id)
    rescue StandardError
      # best effort — the edit will auto-expire
    end
  end
end

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new beta build to Google Play"
  lane :beta do
    sh "flutter build apk --flavor prod --release --dart-define-from-file=../../.prod.json"
    upload_to_play_store(
      track: 'internal',
      apk: '../build/app/outputs/flutter-apk/app-prod-release.apk',
      json_key: 'fastlane/keys/google-play-api-key.json',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "draft",
    )
  end

  desc "Promote beta track to prod"
  lane :promote_to_production do
    upload_to_play_store(
      track: 'beta',
      track_promote_to: 'production',
      json_key: 'fastlane/keys/google-play-api-key.json',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "draft",
    )
  end

  desc "Submit a new production build to Google Play"
  lane :production do
    sh "flutter build apk --flavor prod --release --dart-define-from-file=../../.prod.json"
    upload_to_play_store(
      track: 'production',
      apk: '../build/app/outputs/flutter-apk/app-prod-release.apk',
      json_key: 'fastlane/keys/google-play-api-key.json',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "draft",
    )
  end

  desc "Promote the latest internal release to production without uploading"
  lane :promote_internal do
    json_key_data = ENV['PLAY_STORE_CONFIG_JSON']
    if json_key_data.nil? || json_key_data.empty?
      UI.user_error!("No Google Play JSON key provided. Set PLAY_STORE_CONFIG_JSON env var.")
    end

    package_name = 'meditofoundation.medito'
    expected_version_code = pubspec_version_code

    # No APK upload — the release being promoted already went through the
    # build + smoke gates when it landed on internal. 'completed' sends the
    # production release to Play review and publishes on approval (a draft
    # promote would just recreate the can't-act-on-mobile problem this lane
    # exists to solve).
    begin
      upload_to_play_store(
        track: 'internal',
        track_promote_to: 'production',
        track_promote_release_status: 'completed',
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true,
        json_key_data: json_key_data,
      )
    rescue StandardError => e
      # Play's rollout-coverage check sometimes fires at commit time even
      # after the production track update has persisted. We saw this on
      # 2611.11.0 (run 43059321310) — fastlane errored, but Play Console
      # showed the release rolling out. Rescue only that specific error
      # and verify the production track holds the expected versionCode
      # before treating the promote as successful.
      raise unless e.message.to_s.include?('You cannot rollout this release')

      UI.important("Play returned a rollout-coverage error on the promote.")
      UI.important("Verifying production track holds versionCode #{expected_version_code}...")

      sleep 30 # let Play's edit propagation settle

      prod_codes = production_track_version_codes(json_key_data, package_name)

      if prod_codes.include?(expected_version_code)
        UI.success("Production track includes #{expected_version_code} (current: #{prod_codes.inspect}) — promote landed despite the API error.")
      else
        UI.user_error!(
          "Production track codes #{prod_codes.inspect} do NOT include " \
          "#{expected_version_code}. Promote did not land. Original error: #{e.message}"
        )
      end
    end
  end

  desc "Upload APK to Play Store with custom path and track"
  lane :upload_apk do |options|
    apk_path = options[:apk_path] || '../build/app/outputs/apk/prod/release/app-prod-release.apk'
    track = options[:track] || 'internal'
    promote_to = options[:promote_to]
    submit_review = options[:submit_review].to_s == 'true'

    notes = ENV['RELEASE_NOTES'] || ''
    unless notes.empty?
      require 'fileutils'
      # supply matches a changelog to a release by version-code filename
      # (e.g. 302419.txt) and does NOT fall back to default.txt for a specific
      # APK — so write the version-code file too, or the notes get dropped and
      # the Play Console shows its placeholder. Derive the code from pubspec.
      #
      # Resolve paths from __dir__ (this Fastfile's directory), NOT the process
      # cwd: raw Ruby File ops run with cwd = android/fastlane, so cwd-relative
      # paths like '../pubspec.yaml' break (they'd point at android/, not the
      # repo root). __dir__ is android/fastlane regardless of how fastlane is
      # invoked. Guard the read so a missing pubspec degrades to default.txt
      # rather than crashing the whole deploy.
      pubspec = File.expand_path('../../pubspec.yaml', __dir__)
      version_code = File.exist?(pubspec) ? File.read(pubspec)[/^version:\s*\S+\+(\d+)/, 1] : nil
      ['en-US', 'en-GB', 'es-ES'].each do |locale|
        dir = File.expand_path("metadata/android/#{locale}/changelogs", __dir__)
        FileUtils.mkdir_p(dir)
        File.write("#{dir}/default.txt", notes)
        File.write("#{dir}/#{version_code}.txt", notes) if version_code
      end
    end

    json_key_data = ENV['PLAY_STORE_CONFIG_JSON']
    json_key_path = options[:json_key]

    final_track = promote_to || track
    # Production uploads default to a DRAFT release (someone rolls it out by
    # hand, which is what sends it to Play review). With submit_review:true the
    # release is 'completed' instead: it enters Play review immediately and
    # publishes on approval (unless managed publishing holds it). Non-production
    # tracks have no review step and are always completed.
    production_status = submit_review ? 'completed' : 'draft'
    upload_params = {
      track: track,
      apk: apk_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: notes.empty?,
      release_status: final_track == 'production' ? production_status : 'completed',
    }
    upload_params[:track_promote_to] = promote_to if promote_to

    if json_key_data && !json_key_data.empty?
      upload_params[:json_key_data] = json_key_data
    elsif json_key_path
      upload_params[:json_key] = json_key_path
    else
      UI.user_error!("No Google Play JSON key provided. Set PLAY_STORE_CONFIG_JSON env var or pass json_key option.")
    end

    upload_to_play_store(**upload_params)
  end
end
