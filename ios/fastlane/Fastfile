require 'base64'

default_platform(:ios)

def match_readonly?
  value = ENV["MATCH_READONLY"] || "true"

  return value.strip.downcase != "false"
end

platform :ios do

  before_all do
    # Honour the Xcode that the environment has already selected rather than
    # forcing the runner's *default* `/Applications/Xcode.app` symlink.
    #
    # CI selects the required Xcode (26+, for Apple's now-mandatory iOS 26 SDK)
    # in the workflow's "Select Xcode" step via `xcode-select -s`. Hard-coding
    # `/Applications/Xcode.app` here overrode that and reset the toolchain to
    # the runner's older default Xcode, so `build_app` archived against the
    # iOS 18.5 SDK and App Store Connect rejected the upload:
    #   "Validation failed (409) ... must be built with the iOS 26 SDK or
    #    later, included in Xcode 26 or later."
    # Locally this resolves to the developer's active Xcode — matching the
    # working `build_ios.sh` path, which never overrides the toolchain.
    developer_dir = `xcode-select -p`.strip
    xcode_app = developer_dir.sub(%r{/Contents/Developer/?$}, "")
    # `xcode-select -p` can legitimately point at the Command Line Tools
    # (e.g. `/Library/Developer/CommandLineTools`) rather than an Xcode.app.
    # Only honour it when it resolves to a real Xcode bundle; otherwise fall
    # back to the previous default so local/CLT-only setups keep working.
    unless xcode_app.end_with?(".app") && Dir.exist?(xcode_app)
      xcode_app = "/Applications/Xcode.app"
    end
    xcode_select(xcode_app)
  end

  lane :beta do |options|
    setup_keychain()

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    widget_bundle_id = fetch_profiles()

    Dir.chdir("..") do
      sh(
        "flutter build ios --release " \
        "--dart-define-from-file=.prod.json " \
        "--dart-define=MOCK_MODE=false " \
        "--dart-define=ENABLE_DEVICE_PREVIEW=false " \
        "--no-codesign"
      )
    end

    apply_code_signing(widget_bundle_id)

    build_app(
      workspace: "Runner.xcworkspace",
      configuration: "Release",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["DEVELOPER_APP_IDENTIFIER"] => ENV["PROVISIONING_PROFILE_SPECIFIER"],
          widget_bundle_id => ENV["sigh_#{widget_bundle_id}_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(
      skip_submission: true,
      changelog: ENV["RELEASE_NOTES"] || ""
    )
    cleanup_keychain()
  end

  lane :release do |options|
    setup_keychain()

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    widget_bundle_id = fetch_profiles()

    Dir.chdir("..") do
      sh(
        "flutter build ios --release " \
        "--dart-define-from-file=.prod.json " \
        "--dart-define=MOCK_MODE=false " \
        "--dart-define=ENABLE_DEVICE_PREVIEW=false " \
        "--no-codesign"
      )
    end

    apply_code_signing(widget_bundle_id)

    build_app(
      workspace: "Runner.xcworkspace",
      configuration: "Release",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["DEVELOPER_APP_IDENTIFIER"] => ENV["PROVISIONING_PROFILE_SPECIFIER"],
          widget_bundle_id => ENV["sigh_#{widget_bundle_id}_appstore_profile-name"]
        }
      }
    )

    notes = ENV["RELEASE_NOTES"] || ""
    upload_to_app_store(
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      release_notes: {
        "en-US" => notes,
        "en-GB" => notes,
        "es-MX" => notes
      }
    )
    cleanup_keychain()
  end
end

# Downloads provisioning profiles for the main app and widget extension.
# Returns the widget bundle ID so callers can reference the widget profile.
def fetch_profiles
  widget_bundle_id = "#{ENV["DEVELOPER_APP_IDENTIFIER"]}.widget"

  match(
    type: 'appstore',
    readonly: match_readonly?,
    app_identifier: [ENV["DEVELOPER_APP_IDENTIFIER"], widget_bundle_id],
    git_url: "https://github.com/meditohq/fastlane-certificates.git",
    git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}"),
    keychain_name: ENV["TEMP_KEYCHAIN_USER"],
    keychain_password: ENV["TEMP_KEYCHAIN_PASSWORD"]
  )

  widget_bundle_id
end

# Applies manual code signing settings to each target separately so that
# the MeditoWidgetExtension gets its own profile rather than the main app's.
def apply_code_signing(widget_bundle_id)
  shared = {
    use_automatic_signing: false,
    path: "Runner.xcodeproj",
    team_id: ENV["DEVELOPER_PORTAL_TEAM_ID"],
    code_sign_identity: "iPhone Distribution"
  }

  update_code_signing_settings(
    **shared,
    targets: ["Runner"],
    profile_name: ENV["PROVISIONING_PROFILE_SPECIFIER"]
  )

  update_code_signing_settings(
    **shared,
    targets: ["MeditoWidgetExtension"],
    profile_name: ENV["sigh_#{widget_bundle_id}_appstore_profile-name"]
  )
end

def setup_keychain
  create_keychain(
    name: ENV["TEMP_KEYCHAIN_USER"],
    password: ENV["TEMP_KEYCHAIN_PASSWORD"],
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: true
  )
end

def cleanup_keychain
  delete_keychain(name: ENV["TEMP_KEYCHAIN_USER"])
end
