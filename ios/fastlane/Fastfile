require 'base64'

default_platform(:ios)

def match_readonly?
  value = ENV["MATCH_READONLY"] || "true"

  return value.strip.downcase != "false"
end

# Flutter version Shorebird builds with. MUST match the version pinned in
# .github/workflows/release.yml (subosito/flutter-action) AND be a
# Shorebird-supported version, or patches won't apply to releases built here.
SHOREBIRD_FLUTTER_VERSION = "3.44.7"

# Dart-defines forwarded to the underlying `flutter build`. Passed as
# SHOREBIRD-LEVEL flags (shorebird release/patch accept --dart-define and
# --dart-define-from-file directly and forward them to flutter) — deliberately
# NOT after a `--` separator. Reason: the fastlane-plugin-shorebird
# `shorebird_release` action APPENDS `--export-options-plist <path>` to the END
# of `args`; with a `--` separator that appended flag would land in the
# flutter-build section and break the build. No `--` = the plist flag stays a
# valid shorebird arg. These MUST be byte-for-byte identical between `shorebird
# release` and every later `shorebird patch`, or the patch diff drifts.
SHOREBIRD_DART_DEFINES = [
  "--dart-define-from-file=.prod.json",
  "--dart-define=MOCK_MODE=false",
  "--dart-define=ENABLE_DEVICE_PREVIEW=false",
].join(" ")

platform :ios do

  before_all do
    # Honour the Xcode that the environment has already selected rather than
    # forcing the runner's *default* `/Applications/Xcode.app` symlink.
    #
    # CI selects the required Xcode (26+, for Apple's now-mandatory iOS 26 SDK)
    # in the workflow's "Select Xcode" step via `xcode-select -s`. Hard-coding
    # `/Applications/Xcode.app` here overrode that and reset the toolchain to
    # the runner's older default Xcode, so the archive built against the
    # iOS 18.5 SDK and App Store Connect rejected the upload:
    #   "Validation failed (409) ... must be built with the iOS 26 SDK or
    #    later, included in Xcode 26 or later."
    # Locally this resolves to the developer's active Xcode — matching the
    # working `build_ios.sh` path, which never overrides the toolchain.
    developer_dir = `xcode-select -p`.strip
    xcode_app = developer_dir.sub(%r{/Contents/Developer/?$}, "")
    # `xcode-select -p` can legitimately point at the Command Line Tools
    # (e.g. `/Library/Developer/CommandLineTools`) rather than an Xcode.app.
    # Only honour it when it resolves to a real Xcode bundle; otherwise fall
    # back to the previous default so local/CLT-only setups keep working.
    unless xcode_app.end_with?(".app") && Dir.exist?(xcode_app)
      xcode_app = "/Applications/Xcode.app"
    end
    xcode_select(xcode_app)
  end

  # TestFlight release. Shorebird builds the (patchable) signed .ipa in place of
  # fastlane's build_app/gym; match + per-target manual signing are unchanged.
  lane :beta do |options|
    setup_keychain()

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    build_shorebird_release

    upload_to_testflight(
      skip_submission: true,
      changelog: ENV["RELEASE_NOTES"] || ""
    )
    cleanup_keychain()
  end

  # App Store release (draft; not auto-submitted for review).
  #
  # Pass app_version + build_number to attach a build that is ALREADY on App
  # Store Connect (e.g. the one the beta lane just uploaded in the same
  # workflow run) instead of building again. `shorebird release ios` hard-fails
  # (exit 70, "existing ios release") when a release for the version already
  # exists, so rebuilding after a beta run of the same version can never work.
  # With no build_number the lane builds & uploads exactly as before.
  lane :release do |options|
    use_existing_build = options[:build_number].to_s != ''

    setup_keychain() unless use_existing_build

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    build_shorebird_release unless use_existing_build

    # submit_for_review:true sends the uploaded version straight to App Store
    # review; the default keeps today's behaviour (draft version, submitted by
    # hand). automatic_release stays false so an approved build still needs a
    # manual "Release this version" — approval alone doesn't publish it.
    # Export compliance is pre-answered via ITSAppUsesNonExemptEncryption in
    # Info.plist, so the submission doesn't stall on that question.
    submit = options[:submit_for_review].to_s == 'true'

    notes = ENV["RELEASE_NOTES"] || ""
    upload_options = {
      submit_for_review: submit,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      # Every locale enabled on the App Store listing needs a What's New value,
      # or ASC rejects the review submission ("appStoreVersions ... is not in
      # valid state") — bit the 2607.24.0 release via empty en-CA/fr-FR/de-DE.
      release_notes: {
        "en-US" => notes,
        "en-GB" => notes,
        "en-CA" => notes,
        "es-MX" => notes,
        "fr-FR" => notes,
        "de-DE" => notes
      }
    }

    if use_existing_build
      # No ipa to read the version from, so deliver needs both explicitly.
      # Build selection happens at submission time: with submit_for_review:true
      # deliver picks the build with this build_number (the beta lane's
      # upload_to_testflight has already waited for it to finish processing);
      # with submit_for_review:false the version stays a draft and the build is
      # attached by hand in ASC — same as the build-and-upload path, where
      # uploading the binary doesn't attach it to the version either.
      upload_options[:skip_binary_upload] = true
      upload_options[:app_version] = options[:app_version]
      upload_options[:build_number] = options[:build_number]
    end

    upload_to_app_store(**upload_options)
    cleanup_keychain() unless use_existing_build
  end

  # Dart-only over-the-air patch against an already-shipped release. Does NOT
  # upload to the App Store — it uploads the patch to Shorebird's backend.
  # `release_version` defaults to the most recently updated release; pass an
  # explicit "<name>+<build>" (e.g. "2606.30.0+302422") to target a specific one.
  #
  # IMPORTANT: patches are DART-ONLY. Changes to native code, plugins, the
  # MeditoWidgetExtension, permissions, or bundled assets are detected and
  # rejected by default (shorebird patch blocks on native/asset diffs). Those
  # require a full `fastlane beta`/`release` instead.
  #
  # [VERIFY] The demo `patch` lane omits match/signing; we keep them because
  # `shorebird patch ios` re-runs `flutter build ipa` (to diff) and needs to
  # produce a signed .ipa. Confirm with a `--dry-run` patch before relying on it.
  lane :patch do |options|
    setup_keychain()

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    widget_bundle_id = fetch_profiles()
    apply_code_signing(widget_bundle_id)

    # `shorebird patch ios` re-runs `flutter build ipa` (to diff against the
    # release), so it needs the same manual-signing ExportOptions.plist that
    # the release lane gets. Unlike shorebird_release, the shorebird_patch
    # plugin action does NOT generate one — without it exportArchive fails
    # with "requires a provisioning profile with the App Groups, Apple Pay,
    # ... features". Reuse the plugin's helper directly.
    export_options_plist_path =
      Fastlane::Helper::ExportOptionsPlist.generate_export_options_plist(
        nil,
        lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      )

    release_version = options[:release_version] || "latest"
    track = options[:track] || "staging"
    shorebird_patch(
      platform: "ios",
      # No --flutter-version: `shorebird patch` rejects it (exit 64) and always
      # rebuilds with the Flutter version of the release it targets.
      # --allow-asset-diffs: actool embeds a fresh UUID in the app-icon
      # rendition name on every build, so Assets.car never hashes identically
      # across machines. Shorebird flags that as an asset diff and aborts;
      # patches can't ship assets anyway and the icon is byte-identical in
      # content. If the asset-diff log ever lists MORE than the AppIcon
      # rendition, stop and cut a release instead.
      args: "--release-version=#{release_version} --track=#{track} #{SHOREBIRD_DART_DEFINES} --export-options-plist #{export_options_plist_path} --allow-asset-diffs"
    )
    cleanup_keychain()
  end
end

# Builds and code-signs the .ipa via Shorebird, replacing `flutter build ios
# --no-codesign` + fastlane `build_app`/gym.
#
# How signing works (Approach A, per docs.shorebird.dev/code-push/ci/fastlane):
#   1. fetch_profiles() runs `match`, which populates the fastlane lane context
#      value MATCH_PROVISIONING_PROFILE_MAPPING with BOTH bundle IDs (the app and
#      the widget extension — see fetch_profiles).
#   2. apply_code_signing() puts each target on manual signing in the pbxproj so
#      the archive step matches.
#   3. The fastlane-plugin-shorebird `shorebird_release` action reads that mapping,
#      writes a signingStyle=manual ExportOptions.plist covering both targets, and
#      runs `shorebird release ios --export-options-plist <generated>` — which wraps
#      `flutter build ipa` with the Shorebird engine, so the release is patchable.
#   4. The action sets IPA_OUTPUT_PATH (build/ios/ipa/*.ipa) so the subsequent
#      upload_to_testflight/upload_to_app_store finds the ipa with no `ipa:` param.
#
# Arg ordering: the plugin appends `--export-options-plist <path>` to the END of
# `args`, so we pass dart-defines as shorebird-level flags (NO `--` separator, see
# SHOREBIRD_DART_DEFINES) to keep that appended flag valid.
# [VERIFY on first TestFlight dry-run] if xcodebuild export complains about signing,
# pass explicit keys via
#   export_options: { teamID: ENV["DEVELOPER_PORTAL_TEAM_ID"], signingCertificate: "Apple Distribution" }
def build_shorebird_release
  widget_bundle_id = fetch_profiles()
  apply_code_signing(widget_bundle_id)

  shorebird_release(
    platform: "ios",
    args: "--flutter-version=#{SHOREBIRD_FLUTTER_VERSION} #{SHOREBIRD_DART_DEFINES}"
  )
end

# Downloads provisioning profiles for the main app and widget extension.
# Returns the widget bundle ID so callers can reference the widget profile.
def fetch_profiles
  widget_bundle_id = "#{ENV["DEVELOPER_APP_IDENTIFIER"]}.widget"

  match(
    type: 'appstore',
    readonly: match_readonly?,
    app_identifier: [ENV["DEVELOPER_APP_IDENTIFIER"], widget_bundle_id],
    git_url: "https://github.com/meditohq/fastlane-certificates.git",
    git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}"),
    keychain_name: ENV["TEMP_KEYCHAIN_USER"],
    keychain_password: ENV["TEMP_KEYCHAIN_PASSWORD"]
  )

  widget_bundle_id
end

# Applies manual code signing settings to each target separately so that
# the MeditoWidgetExtension gets its own profile rather than the main app's.
def apply_code_signing(widget_bundle_id)
  shared = {
    use_automatic_signing: false,
    path: "Runner.xcodeproj",
    team_id: ENV["DEVELOPER_PORTAL_TEAM_ID"],
    code_sign_identity: "iPhone Distribution"
  }

  update_code_signing_settings(
    **shared,
    targets: ["Runner"],
    profile_name: ENV["PROVISIONING_PROFILE_SPECIFIER"]
  )

  update_code_signing_settings(
    **shared,
    targets: ["MeditoWidgetExtension"],
    profile_name: ENV["sigh_#{widget_bundle_id}_appstore_profile-name"]
  )
end

def setup_keychain
  create_keychain(
    name: ENV["TEMP_KEYCHAIN_USER"],
    password: ENV["TEMP_KEYCHAIN_PASSWORD"],
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: true
  )
end

def cleanup_keychain
  delete_keychain(name: ENV["TEMP_KEYCHAIN_USER"])
end
